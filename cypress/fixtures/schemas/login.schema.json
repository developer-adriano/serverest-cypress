{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resposta de POST /login",
  "type": "object",
  "required": ["message", "authorization"],
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "authorization": { "type": "string", "pattern": "^Bearer .+" }
  },
  "additionalProperties": false
}
