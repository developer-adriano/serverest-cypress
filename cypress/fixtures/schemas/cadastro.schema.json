{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resposta generica de cadastro (POST)",
  "type": "object",
  "required": ["message", "_id"],
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "_id": { "type": "string", "pattern": "^[a-zA-Z0-9]{16}$" }
  },
  "additionalProperties": false
}
